<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Mahjong Score Calculator</title>
<style>
  body {
    font-family: Arial, sans-serif;
    margin: 20px;
  }
  h1 {
    text-align: center;
  }
  #room {
    margin-bottom: 20px;
  }
  #players {
    margin-bottom: 20px;
  }
  .player {
    border: 1px solid #ccc;
    padding: 10px;
    margin-bottom: 10px;
  }
  .player h3 {
    margin: 0 0 10px 0;
  }
  .upload-section {
    margin-top: 10px;
  }
  button {
    margin-top: 10px;
  }
  #results {
    margin-top: 20px;
  }
</style>
</head>
<body>

<h1>Mahjong Score Calculator</h1>

<div id="room">
  <label for="playerCount">Number of Players (2-4): </label>
  <input type="number" id="playerCount" min="2" max="4" value="2" />
  <button onclick="createRoom()">Create Room</button>
</div>

<div id="players"></div>

<div id="calculateSection" style="display:none;">
  <button onclick="calculateScores()">Calculate Scores</button>
</div>

<div id="results"></div>

<script>
let players = [];

function createRoom() {
  const count = parseInt(document.getElementById('playerCount').value);
  if (count < 2 || count > 4) {
    alert('Please select between 2 and 4 players.');
    return;
  }
  players = [];
  const container = document.getElementById('players');
  container.innerHTML = '';
  for (let i = 0; i < count; i++) {
    const playerDiv = document.createElement('div');
    playerDiv.className = 'player';
    playerDiv.id = 'player' + i;
    playerDiv.innerHTML = `
      <h3>Player ${i+1}</h3>
      <div>Points: <span id="points${i}">1000</span></div>
      <div class="upload-section">
        <label>Upload Winning Tile Image: </label>
        <input type="file" accept="image/*" onchange="loadImage(event, ${i})" />
        <img id="imgPreview${i}" style="max-width:100px; display:none; margin-top:10px;" />
      </div>
      <div>
        <label>Winning Hand Type: </label>
        <select id="handType${i}">
          <option value="none">Select Hand Type</option>
          <option value="self">Self-Pick (No Fan points)</option>
          <option value="concealed">Concealed Hand</option>
          <option value="sevenFlowers">Seven Flowers</option>
          <option value="fullFlush">Full Flush</option>
          <option value="blessingHeaven">Blessing of Heaven</option>
          <option value="blessingEarth">Blessing of Earth</option>
          <option value="blessingMan">Blessing of Man</option>
          <option value="thirteenOrphans">Thirteen Orphans</option>
          <option value="sevenPairs">Seven Pairs</option>
          <option value="bigThreeDragons">Big Three Dragons</option>
        </select>
      </div>
      <div>
        <label>Win Type: </label>
        <select id="winType${i}">
          <option value="self">Self Pick</option>
          <option value="discard">Discard</option>
        </select>
      </div>
      <div id="discardFromDiv${i}" style="display:none;">
        <label>Discarded by Player: </label>
        <select id="discardPlayer${i}">
          <option value="">Select Player</option>
        </select>
      </div>
    `;
    container.appendChild(playerDiv);
    players.push({ points: 1000, fan: 0, image: null, handType: 'none', winType: 'self', discardFrom: null });
  }
  // Populate discard options
  for (let i = 0; i < count; i++) {
    const select = document.getElementById(`discardPlayer${i}`);
    for (let j = 0; j < count; j++) {
      if (j !== i) {
        const option = document.createElement('option');
        option.value = j;
        option.text = `Player ${j+1}`;
        select.appendChild(option);
      }
    }
  }
  // Add event listeners for winType change
  for (let i = 0; i < count; i++) {
    document.getElementById(`winType${i}`).addEventListener('change', (e) => {
      document.getElementById(`discardFromDiv${i}`).style.display = e.target.value === 'discard' ? 'block' : 'none';
    });
  }
  // Add event listeners for handType change
  for (let i = 0; i < count; i++) {
    document.getElementById(`handType${i}`).addEventListener('change', (e) => {
      // No additional action needed for now
    });
  }
  document.getElementById('calculateSection').style.display = 'block';
  document.getElementById('results').innerHTML = '';
}

// Load image preview
function loadImage(event, playerIndex) {
  const image = event.target.files[0];
  if (image) {
    const reader = new FileReader();
    reader.onload = function(e) {
      document.getElementById(`imgPreview${playerIndex}`).src = e.target.result;
      document.getElementById(`imgPreview${playerIndex}`).style.display = 'block';
      players[playerIndex].image = image;
    }
    reader.readAsDataURL(image);
  }
}

// Function to get fan points based on hand type
function getFanPointsByHandType(handType) {
  switch (handType) {
    case 'self': return 0; // Self pick, no fan points
    case 'concealed': return 1; // Concealed Hand
    case 'sevenFlowers': return 4; // Seven Flowers
    case 'fullFlush': return 7; // Full Flush
    case 'blessingHeaven': return 13; // Blessing of Heaven
    case 'blessingEarth': return 13; // Blessing of Earth
    case 'blessingMan': return 13; // Blessing of Man
    case 'thirteenOrphans': return 13;
    case 'sevenPairs': return 4;
    case 'bigThreeDragons': return 8;
    default: return 0;
  }
}

function calculateScores() {
  const count = players.length;
  // Get inputs
  let valid = true;
  for (let i = 0; i < count; i++) {
    // Get hand type and set fan points
    const handType = document.getElementById(`handType${i}`).value;
    let fanPoints = getFanPointsByHandType(handType);
    if (fanPoints < 3) {
      // If less than 3, no points
      players[i].fan = 0;
    } else {
      players[i].fan = fanPoints;
    }
    players[i].handType = handType;

    // Get win type
    const winType = document.getElementById(`winType${i}`).value;
    players[i].winType = winType;
    if (winType === 'discard') {
      const discardFrom = document.getElementById(`discardPlayer${i}`).value;
      if (discardFrom === '') {
        alert(`Please select who discarded for Player ${i+1}`);
        valid = false;
        break;
      } else {
        players[i].discardFrom = parseInt(discardFrom);
      }
    } else {
      players[i].discardFrom = null;
    }
  }
  if (!valid) return;

  // Reset points
  players.forEach(p => {
    p.points = 1000;
  });

  // Calculate points
  let resultsHTML = '';
  for (let i = 0; i < count; i++) {
    const player = players[i];
    if (player.fan < 3) {
      resultsHTML += `<p>Player ${i+1}: Fan < 3, no points gained or lost. Total Points: ${player.points}</p>`;
      continue;
    }
    // Scoring: fan points * 10 (example)
    let score = player.fan * 10;
    if (score < 30) score = 0; // no points if fan<3
    if (player.winType === 'self') {
      // Self-pick: player gains points
      player.points += score;
    } else if (player.winType === 'discard') {
      // Discard win: opponent loses points
      const discarder = player.discardFrom;
      if (discarder !== null) {
        players[discarder].points -= score;
        player.points += score;
      }
    }
    resultsHTML += `<p>Player ${i+1}: Fan = ${player.fan}, Points Gained/Lost = ${score}, Total Points = ${player.points}</p>`;
  }
  document.getElementById('results').innerHTML = resultsHTML;
}
</script>

</body>
</html>
